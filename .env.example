# انسخ إلى .env.local — لا تُحفظ القيم الحقيقية في المستودع أبداً.
# القيم المحلية يطبعها: npx supabase status

# ---- يصل إلى المتصفح (آمن للنشر) ----
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# ---- خادم فقط: FastAPI و n8n (PLAN_v3.md §3.3 بند 12) ----
# لا يُستعمل أبداً في apps/web ولا يُمرَّر لأي عميل.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---- FastAPI (services/api) — خادم فقط ----
# الخدمة لا تحمل SUPABASE_SERVICE_ROLE_KEY: تتصل بدور authenticator (آلية PostgREST) وتنتقل إلى
# authenticated لكل طلب. كلمة المرور أدناه هي الافتراضية المحلية؛ في الإنتاج من مخزن الأسرار.
API_DATABASE_URL=postgresql://authenticator:postgres@127.0.0.1:54322/postgres
# التحقق بالمفتاح العام من JWKS ({SUPABASE_URL}/auth/v1/.well-known/jwks.json)؛ HS256 مرفوضة
API_JWT_ALGORITHMS=ES256
API_JWT_AUDIENCE=authenticated
# المفتاح المنشور (عام) — لتسجيل دخول الطالب عبر Supabase Auth (F2/D1)
SUPABASE_PUBLISHABLE_KEY=
# خادم فقط: Auth Admin API لـSaga إنشاء الطالب — يقرؤه services/api/app/auth_admin.py وحده
SUPABASE_SECRET_KEY=
# يطابق minimum_password_length في إعداد Supabase Auth (كلمة المرور الأولية للطالب = معرّفه)
API_MIN_PASSWORD_LENGTH=6
# قناة رمز OTP (D3): local = مرسل تطوير في الذاكرة؛ بلا قيمة ⇒ مسارات OTP ترد 503. القناة الحقيقية: المرحلة 5
API_OTP_SENDER=
